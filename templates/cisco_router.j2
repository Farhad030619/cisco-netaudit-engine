! ==============================================================================
! Cisco IOS-XE Router Configuration Template
! Generated by Cisco-NetAudit & Config Engine
! ==============================================================================
version 17.3
no service pad
service timestamps debug datetime msec
service timestamps log datetime msec
service password-encryption
!
hostname {{ router.hostname }}
!
ip domain-name {{ router.domain_name }}
!
! --- Security & AAA Hardening ---
aaa new-model
aaa authentication login default local
aaa authorization exec default local
!
ip ssh version 2
ip ssh time-out 60
ip ssh authentication-retries 3
!
no ip http server
no ip http secure-server
no ip domain-lookup
!
! --- Banner ---
banner motd ^C
======================================================================
{{ router.banner }}
======================================================================
^C
!
! --- Interfaces ---
{% for intf in router.interfaces %}
interface {{ intf.name }}
 description {{ intf.description }}
 ip address {{ intf.ip }} {{ intf.mask }}
{% if intf.ospf_cost %}
 ip ospf cost {{ intf.ospf_cost }}
{% endif %}
{% if intf.enabled %}
 no shutdown
{% else %}
 shutdown
{% endif %}
!
{% endfor %}
!
! --- OSPF Configuration ---
{% if router.ospf %}
router ospf {{ router.ospf.process_id }}
 router-id {{ router.ospf.router_id }}
{% for net in router.ospf.networks %}
 network {{ net.network }} {{ net.wildcard }} area {{ net.area }}
{% endfor %}
!
{% endif %}
!
! --- BGP Configuration ---
{% if router.bgp %}
router bgp {{ router.bgp.asn }}
 bgp router-id {{ router.bgp.router_id }}
 bgp log-neighbor-changes
{% for nbr in router.bgp.neighbors %}
 neighbor {{ nbr.ip }} remote-as {{ nbr.remote_as }}
 neighbor {{ nbr.ip }} description {{ nbr.description }}
{% endfor %}
!
{% endif %}
!
! --- Logging & Management ---
{% if router.syslog_server %}
logging trap notifications
logging host {{ router.syslog_server }}
{% endif %}
{% for ntp in router.ntp_servers %}
ntp server {{ ntp }}
{% endfor %}
!
! --- Line Security ---
line con 0
 exec-timeout 10 0
 logging synchronous
 login authentication default
line vty 0 4
 exec-timeout 10 0
 logging synchronous
 transport input ssh
 login authentication default
line vty 5 15
 exec-timeout 10 0
 logging synchronous
 transport input ssh
 login authentication default
!
end
