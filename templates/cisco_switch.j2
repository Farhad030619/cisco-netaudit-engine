! ==============================================================================
! Cisco IOS Catalyst Switch Configuration Template
! Generated by Cisco-NetAudit & Config Engine
! ==============================================================================
version 15.2
no service pad
service password-encryption
service timestamps debug datetime msec
service timestamps log datetime msec
!
hostname {{ switch.hostname }}
!
ip domain-name {{ switch.domain_name }}
!
spanning-tree mode rapid-pvst
spanning-tree portfast default
spanning-tree portfast bpduguard default
!
! --- VLAN Database ---
{% for vlan in switch.vlans %}
vlan {{ vlan.id }}
 name {{ vlan.name }}
!
{% endfor %}
!
! --- Interfaces ---
{% for intf in switch.interfaces %}
interface {{ intf.name }}
 description {{ intf.description }}
{% if intf.mode == "access" %}
 switchport mode access
 switchport access vlan {{ intf.access_vlan }}
{% if intf.voice_vlan %}
 switchport voice vlan {{ intf.voice_vlan }}
{% endif %}
{% if intf.portfast %}
 spanning-tree portfast
{% endif %}
{% if intf.bpduguard %}
 spanning-tree bpduguard enable
{% endif %}
{% elif intf.mode == "trunk" %}
 switchport trunk encapsulation dot1q
 switchport mode trunk
 switchport trunk native vlan {{ intf.native_vlan }}
 switchport trunk allowed vlan {{ intf.allowed_vlans }}
{% endif %}
 no shutdown
!
{% endfor %}
!
! --- Line Security ---
line vty 0 15
 exec-timeout 10 0
 transport input ssh
!
end
